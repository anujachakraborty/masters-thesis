<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/LINSimulationModelOntology#"
     xml:base="http://example.org/LINSimulationModelOntology"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:bfo="http://purl.obolibrary.org/obo/bfo#"
     xmlns:css="https://raw.githubusercontent.com/CaSkade-Automation/CSS/main/CSS-Ontology#"
     xmlns:obo="http://purl.obolibrary.org/obo/"
	 xmlns:ont="http://example.org/ontology#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:idta="http://www.semanticweb.org/eklaspad/ontologies/2022/6/untitled-ontology-5#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:vdi3633="https://raw.githubusercontent.com/JonathanReif/SiS/main/Resources/VDI3633#"
     xmlns:iso25010="http://www.example.org/iso25010#">
    
    <owl:Ontology rdf:about="http://example.org/LINSimulationModelOntology">
     <owl:imports rdf:resource="http://example.org/ontology"/> 
    </owl:Ontology>

<!-- LIN Simulation Model -->

<owl:Class rdf:about="http://example.org/LINSimulationModelOntology#LIN_SimulationModel">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/eklaspad/ontologies/2022/6/untitled-ontology-5#SimulationModel"/>
    <rdfs:comment xml:lang="en">Simulation model for LIN master-slave communication.</rdfs:comment>
</owl:Class>

<!-- Capabilities -->

<owl:Class rdf:about="http://example.org/LINSimulationModelOntology#MasterSlaveScheduling">
    <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/css#Capability"/>
	<owl:equivalentClass rdf:resource="http://www.semanticweb.org/eklaspad/ontologies/2022/6/untitled-ontology-5#simPurpose"/>
	<rdfs:comment xml:lang="en">Validation of LIN master-slave scheduling and communication.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="http://example.org/LINSimulationModelOntology#FrameTransmission">
    <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/css#Capability"/>
	<owl:equivalentClass rdf:resource="http://www.semanticweb.org/eklaspad/ontologies/2022/6/untitled-ontology-5#simPurpose"/>
	<rdfs:comment xml:lang="en">Simulating transmission of different frame types such as unconditional, sporadic, and event triggered.</rdfs:comment>
</owl:Class>

<!-- 
<owl:Class rdf:about="http://example.org/LINSimulationModelOntology#TimingConstraintEvaluation">
    <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/css#Capability"/>
</owl:Class> -->

<!-- Resources -->

<owl:Class rdf:about="http://example.org/LINSimulationModelOntology#LIN_MasterNode">
    <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/css#Resource"/>
	<rdfs:comment xml:lang="en">Always controls the bus scheduling and initiates all frame transfers in the LIN network.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="http://example.org/LINSimulationModelOntology#LIN_SlaveNode">
    <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/css#Resource"/>
	<rdfs:comment xml:lang="en">Responds to master requests (cannot initiate frames) in the LIN network.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="http://example.org/LINSimulationModelOntology#LIN_Port">
    <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/css#Resource"/>
		<owl:equivalentClass rdf:resource="http://www.semanticweb.org/eklaspad/ontologies/2022/6/untitled-ontology-5#portsConnector"/>
	<rdfs:comment xml:lang="en">Ports are for enabling bidirectional communication between master and slave nodes in the same network interface that can transmit and receive frames.</rdfs:comment>
</owl:Class>

<!-- Processes -->

<owl:Class rdf:about="http://example.org/LINSimulationModelOntology#MasterScheduledCommunication">
    <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/css#Process"/>
	<rdfs:comment xml:lang="en"> Master controlled communication through the scheduling mechanism defined in the LDF or manual configuration.</rdfs:comment>
</owl:Class>

 <!-- Quality Attributes -->

<owl:Class rdf:about="http://example.org/LINSimulationModelOntology#SchedulingAccuracy">
    <rdfs:subClassOf rdf:resource="http://www.example.org/iso25010#PerformanceEfficiency"/>
</owl:Class>

<!-- Object Properties -->

	<rdf:Description rdf:about="http://example.org/LINSimulationModelOntology#LIN_SimulationModel">
	  <ont:usesResource rdf:resource="http://example.org/LINSimulationModelOntology#LIN_MasterNode"/>
	  <ont:usesResource rdf:resource="http://example.org/LINSimulationModelOntology#LIN_SlaveNode"/>
	</rdf:Description>
	
	<rdf:Description rdf:about="http://example.org/LINSimulationModelOntology#LIN_SimulationModel">
	  <ont:hasCapability rdf:resource="http://example.org/LINSimulationModelOntology#MasterSlaveScheduling"/>
	  <ont:hasCapability rdf:resource="http://example.org/LINSimulationModelOntology#FrameTransmission"/>
	</rdf:Description>

<!-- DataType Properties -->

<owl:DatatypeProperty rdf:about="http://example.org/LINSimulationModelOntology#hasBitRate">
    <rdfs:domain rdf:resource="http://example.org/LINSimulationModelOntology#LIN_SimulationModel"/>
    <rdfs:range rdf:resource="xsd:integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/LINSimulationModelOntology#hasTimeBase">
    <rdfs:domain rdf:resource="http://example.org/LINSimulationModelOntology#LIN_SimulationModel"/>
    <rdfs:range rdf:resource="xsd:integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/LINSimulationModelOntology#hasScheduleStartDelay">
    <rdfs:domain rdf:resource="http://example.org/LINSimulationModelOntology#LIN_SimulationModel"/>
    <rdfs:range rdf:resource="xsd:integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/LINSimulationModelOntology#hasPayloadSize">
    <rdfs:domain rdf:resource="http://example.org/LINSimulationModelOntology#LIN_Port"/>
    <rdfs:range rdf:resource="xsd:integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/LINSimulationModelOntology#hasFrameID">
    <rdfs:domain rdf:resource="http://example.org/LINSimulationModelOntology#LIN_Port"/>
    <rdfs:range rdf:resource="xsd:integer"/>
</owl:DatatypeProperty>

</rdf:RDF>