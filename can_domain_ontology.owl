</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/CANSimulationModelOntology#hasType">
    <rdfs:domain rdf:resource="http://example.org/CANSimulationModelOntology#MessageFrameTransmission"/>
    <rdfs:range rdf:resource="xsd:string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/CANSimulationModelOntology#hasSpeedMetersPerSecond">
    <rdfs:domain rdf:resource="http://example.org/CANSimulationModelOntology#SimulationSettings"/>
