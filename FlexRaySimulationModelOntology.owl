<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/FlexRaySimulationModelOntology#"
     xml:base="http://example.org/FlexRaySimulationModelOntology"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:bfo="http://purl.obolibrary.org/obo/bfo#"
     xmlns:css="https://raw.githubusercontent.com/CaSkade-Automation/CSS/main/CSS-Ontology#"
     xmlns:obo="http://purl.obolibrary.org/obo/"
	 xmlns:ont="http://example.org/ontology#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:idta="http://www.semanticweb.org/eklaspad/ontologies/2022/6/untitled-ontology-5#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:vdi3633="https://raw.githubusercontent.com/JonathanReif/SiS/main/Resources/VDI3633#"
     xmlns:iso25010="http://www.example.org/iso25010#">
    
    <owl:Ontology rdf:about="http://example.org/FlexRaySimulationModelOntology">
         <owl:imports rdf:resource="http://example.org/ontology"/>
    </owl:Ontology>

 <!-- FlexRay Simulation Model -->

<owl:Class rdf:about="http://example.org/FlexRaySimulationModelOntology#FlexRay_SimulationModel">
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/eklaspad/ontologies/2022/6/untitled-ontology-5#SimulationModel"/>
    <rdfs:comment xml:lang="en">Simulation model for FlexRay deterministic communication.</rdfs:comment>
</owl:Class>

 <!-- Capabilities -->
 
<owl:Class rdf:about="http://example.org/FlexRaySimulationModelOntology#TimeTriggeredCommunication">
    <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/css#Capability"/>
	<owl:equivalentClass rdf:resource="http://www.semanticweb.org/eklaspad/ontologies/2022/6/untitled-ontology-5#simPurpose"/>
	<rdfs:comment xml:lang="en">Time-Triggered behaviour enables deterministic communication with its static segment for periodic, time-critical data.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="http://example.org/FlexRaySimulationModelOntology#EventDrivenCommunication">
    <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/css#Capability"/>
	<owl:equivalentClass rdf:resource="http://www.semanticweb.org/eklaspad/ontologies/2022/6/untitled-ontology-5#simPurpose"/>
	<rdfs:comment xml:lang="en">Event-Driven communication enables flexible bandwidth allocation with its dynamic segment for event-driven, less time-critical data.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="http://example.org/FlexRaySimulationModelOntology#DualChannelCommunication">
    <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/css#Capability"/>
	<owl:equivalentClass rdf:resource="http://www.semanticweb.org/eklaspad/ontologies/2022/6/untitled-ontology-5#simPurpose"/>
	<rdfs:comment xml:lang="en">FlexRay's Dual Channel Architecture allows parallel transmission on both channels simultaneously.</rdfs:comment>
</owl:Class>

 <!-- Resources -->

<owl:Class rdf:about="http://example.org/FlexRaySimulationModelOntology#FlexRay_Node">
    <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/css#Resource"/>
	<rdfs:comment xml:lang="en">Nodes are the individual devices connected to the FlexRay network. Each node can both transmit and receive messages on the network using dual channels.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="http://example.org/FlexRaySimulationModelOntology#FlexRay_Port">
    <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/css#Resource"/>
	<owl:equivalentClass rdf:resource="http://www.semanticweb.org/eklaspad/ontologies/2022/6/untitled-ontology-5#portsConnector"/>
	<rdfs:comment xml:lang="en">Ports are for connecting several applications to the same network interface that can transmit and receive value events to and from the ApplicationInterface instance.</rdfs:comment>
</owl:Class>


<owl:Class rdf:about="http://example.org/FlexRaySimulationModelOntology#HybridCommunication">
    <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/css#Process"/>
	<rdfs:comment xml:lang="en">FlexRay's hybrid communication combines deterministic time-triggered communication with flexible bandwidth allocation, all supported by dual redundant channels for high reliability.</rdfs:comment>
</owl:Class>


<owl:Class rdf:about="http://example.org/FlexRaySimulationModelOntology#Flexibility">
    <rdfs:subClassOf rdf:resource="http://www.example.org/iso25010#Portability"/>
</owl:Class>

<owl:Class rdf:about="http://example.org/FlexRaySimulationModelOntology#Reliability">
    <owl:equivalentClass rdf:resource="http://www.example.org/iso25010#Reliability"/>
</owl:Class>

<!-- Object Properties -->


	<rdf:Description rdf:about="http://example.org/FlexRaySimulationModelOntology#FlexRay_SimulationModel">
	  <ont:usesResource rdf:resource="http://example.org/FlexRaySimulationModelOntology#FlexRay_Port"/>
	</rdf:Description>
	
	<rdf:Description rdf:about="http://example.org/FlexRaySimulationModelOntology#FlexRay_SimulationModel">
	  <ont:hasCapability rdf:resource="http://example.org/FlexRaySimulationModelOntology#TimeTriggeredCommunication"/>
	  <ont:hasCapability rdf:resource="http://example.org/FlexRaySimulationModelOntology#EventDrivenCommunication"/>
	  <ont:hasCapability rdf:resource="http://example.org/FlexRaySimulationModelOntology#DualChannelCommunication"/>
	</rdf:Description>


<owl:DatatypeProperty rdf:about="http://example.org/FlexRaySimulationModelOntology#hasPayloadSize">
    <rdfs:domain rdf:resource="http://example.org/FlexRaySimulationModelOntology#FlexRay_Port"/>
    <rdfs:range rdf:resource="xsd:integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/FlexRaySimulationModelOntology#hasSlotValue">
    <rdfs:domain rdf:resource="http://example.org/FlexRaySimulationModelOntology#FlexRay_Port"/>
    <rdfs:range rdf:resource="xsd:integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/FlexRaySimulationModelOntology#hasSegmentType">
    <rdfs:domain rdf:resource="http://example.org/FlexRaySimulationModelOntology#FlexRay_Port"/>
    <rdfs:range rdf:resource="xsd:string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://example.org/FlexRaySimulationModelOntology#hasBitRate">
    <rdfs:domain rdf:resource="http://example.org/FlexRaySimulationModelOntology#FlexRay_SimulationModel"/>
    <rdfs:range rdf:resource="xsd:integer"/>
</owl:DatatypeProperty>


<owl:DatatypeProperty rdf:about="http://example.org/FlexRaySimulationModelOntology#hasGdStaticSlot">
    <rdfs:domain rdf:resource="http://example.org/FlexRaySimulationModelOntology#FlexRay_SimulationModel"/>
    <rdfs:range rdf:resource="xsd:integer"/>
</owl:DatatypeProperty>

</rdf:RDF>