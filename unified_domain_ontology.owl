<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/UnifiedSimulationModelOntology#"
     xml:base="http://example.org/UnifiedSimulationModelOntology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://example.org/UnifiedSimulationModelOntology">
        <owl:imports rdf:resource="http://example.org/CANSimulationModelOntology"/>
        <owl:imports rdf:resource="http://example.org/LINSimulationModelOntology"/>
        <owl:imports rdf:resource="http://example.org/FlexRaySimulationModelOntology"/>
        <owl:imports rdf:resource="http://example.org/EthernetSimulationModelOntology"/>
        <!--  <owl:imports rdf:resource="http://example.org/ontology"/>-->
    </owl:Ontology>

</rdf:RDF>
