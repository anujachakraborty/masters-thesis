     xml:base="http://example.org/ontology"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:bfo="http://purl.obolibrary.org/obo/bfo#"
     xmlns:css="https://raw.githubusercontent.com/CaSkade-Automation/CSS/main/CSS-Ontology#"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:idta="http://www.semanticweb.org/eklaspad/ontologies/2022/6/untitled-ontology-5#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:vdi3633="https://raw.githubusercontent.com/JonathanReif/SiS/main/Resources/VDI3633#"
     xmlns:iso25010="http://www.example.org/iso25010#">
    <owl:Ontology rdf:about="http://example.org/ontology">
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
        <owl:imports rdf:resource="http://www.semanticweb.org/eklaspad/ontologies/2022/6/untitled-ontology-5"/>
        <owl:imports rdf:resource="https://raw.githubusercontent.com/CaSkade-Automation/CSS/main/CSS-Ontology.owl"/>
        <owl:imports rdf:resource="https://raw.githubusercontent.com/JonathanReif/SiS/main/Resources/VDI3633.owl"/>
    </owl:Ontology>
    


    <!-- 
